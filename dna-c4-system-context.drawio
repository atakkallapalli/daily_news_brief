          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="system" value="DNA (Daily News AI)&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Aggregates news from RSS feeds,&lt;br&gt;analyzes relevance using AI,&lt;br&gt;and presents summarized articles&lt;br&gt;organized by topics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0D5EAF;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
